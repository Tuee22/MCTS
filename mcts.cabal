benchmark mcts-criterion
    type:             exitcode-stdio-1.0
    main-is:          criterion-suites.hs
    hs-source-dirs:   bench
    default-language: Haskell2010
    ghc-options:
        -Wall -Wcompat -O2 -funbox-strict-fields -fspecialise-aggressively
        -fexpose-all-unfoldings -flate-dmd-anal
        -fmax-simplifier-iterations=20 -fworker-wrapper
        -fstatic-argument-transformation -fllvm

    build-depends:
        base >=4.20 && <5,
        criterion,
        mcts
