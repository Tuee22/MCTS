cabal-version: 3.8
name:          mcts
version:       0.1.0.0
license-file:  LICENCE
maintainer:    matt
author:        MCTS contributors
tested-with:   ghc ==9.14.1
build-type:    Simple

library
    exposed-modules:
        MCTS.App
        MCTS.Crypto.SHA256
        MCTS.CLI.Bench
        MCTS.CLI.Build
        MCTS.CLI.Command
        MCTS.CLI.Docs
        MCTS.CLI.Inspect
        MCTS.CLI.Json
        MCTS.CLI.Lint
        MCTS.CLI.Output
        MCTS.CLI.Parser
        MCTS.CLI.Spec
        MCTS.CLI.Test
        MCTS.CLI.Tree
        MCTS.CLI.Tui.Board
        MCTS.CLI.Tui.Play
        MCTS.CLI.Tui.Replay
        MCTS.CLI.Verify
        MCTS.CheckCode
        MCTS.Driver
        MCTS.Driver.Dispatch
        MCTS.Driver.ForeignSearch
        MCTS.Driver.ForeignSmoke
        MCTS.Driver.Rust
        MCTS.Engine
        MCTS.Engine.Envelope
        MCTS.Engine.ForeignRecompute
        MCTS.Engine.Recompute
        MCTS.Env
        MCTS.Error
        MCTS.FFI.Common
        MCTS.FFI.CppFunctional
        MCTS.FFI.CppImperative
        MCTS.FFI.CppLegacy
        MCTS.FFI.Rust
        MCTS.Generated.Paths
        MCTS.Generated.Sections
        MCTS.Notation
        MCTS.Plan
        MCTS.Prerequisite
        MCTS.ReportCard
        MCTS.Rng.Cpp
        MCTS.Rng.Mix
        MCTS.Search.Arena
        MCTS.Search.UCT
        MCTS.Subprocess
        MCTS.Transcript
        MCTS.Transcript.Action
        MCTS.Transcript.Cache
        MCTS.Transcript.Codec
        MCTS.Transcript.EquitySidecar
        MCTS.Transcript.Hash
        MCTS.Transcript.Lookup
        MCTS.Types
        MCTS.Verify
        MCTS.Verify.Divergence
        MCTS.Verify.Envelope
        MCTS.Verify.Semantic

    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:
        -Wall -Wcompat -O2 -funbox-strict-fields -fspecialise-aggressively
        -fexpose-all-unfoldings -flate-dmd-anal
        -fmax-simplifier-iterations=20 -fworker-wrapper
        -fstatic-argument-transformation -fllvm

    build-depends:
        aeson,
        ansi-terminal,
        array,
        base >=4.20 && <5,
        brick,
        bytestring,
        containers,
        directory,
        filepath,
        mtl,
        optparse-applicative,
        path,
        path-io,
        prettyprinter,
        prettyprinter-ansi-terminal,
        safe-exceptions,
        temporary,
        text,
        time,
        transformers,
        typed-process,
        unix,
        vty

executable mcts
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:
        -Wall -Wcompat -O2 -funbox-strict-fields -fspecialise-aggressively
        -fexpose-all-unfoldings -flate-dmd-anal
        -fmax-simplifier-iterations=20 -fworker-wrapper
        -fstatic-argument-transformation -fllvm -threaded
        "-with-rtsopts=-A64m -n4m -qg1 -qb -T"

    build-depends:
        base >=4.20 && <5,
        mcts

test-suite mcts-unit
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test/unit
    default-language: Haskell2010
    ghc-options:
        -Wall -Wcompat -O2 -funbox-strict-fields -fspecialise-aggressively
        -fexpose-all-unfoldings -flate-dmd-anal
        -fmax-simplifier-iterations=20 -fworker-wrapper
        -fstatic-argument-transformation

    build-depends:
        array,
        aeson,
        base >=4.20 && <5,
        bytestring,
        directory,
        filepath,
        mcts,
        mtl,
        optparse-applicative,
        tasty,
        tasty-hunit,
        tasty-quickcheck,
        temporary,
        text,
        transformers

test-suite mcts-integration
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test/integration
    default-language: Haskell2010
    ghc-options:
