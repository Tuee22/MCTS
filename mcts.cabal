cabal-version:      3.8
name:               mcts
version:            0.1.0.0
license-file:       LICENCE
author:             MCTS contributors
maintainer:         matt
build-type:         Simple
tested-with:        GHC ==9.14.1

common warnings
    -- Phase 8 Sprint 8.1 doctrine-named GHC tuning options. `-fllvm`
    -- and `-optlo-mcpu=native` / `-optlc-mcpu=native` require LLVM
    -- pinned in the Docker image (Sprint 1.1); they're held back from
    -- this common stanza until that pin lands. Everything else here is
    -- safe to enable now and helps the search-loop inliner without an
    -- LLVM dependency.
    ghc-options:
        -Wall
        -Wcompat
        -O2
        -funbox-strict-fields
        -fspecialise-aggressively
        -fexpose-all-unfoldings
        -flate-dmd-anal
        -fmax-simplifier-iterations=20
        -fworker-wrapper
        -fstatic-argument-transformation
    default-language: Haskell2010

library
    import: warnings
    hs-source-dirs: src
    exposed-modules:
        MCTS.App
        MCTS.Crypto.SHA256
        MCTS.CLI.Bench
        MCTS.CLI.Build
        MCTS.CLI.Command
        MCTS.CLI.Docs
        MCTS.CLI.Inspect
        MCTS.CLI.Lint
        MCTS.CLI.Output
        MCTS.CLI.Parser
        MCTS.CLI.Spec
        MCTS.CLI.Test
        MCTS.CLI.Verify
        MCTS.Driver
        MCTS.Engine
        MCTS.Engine.Recompute
        MCTS.Env
        MCTS.Error
        MCTS.FFI.Common
        MCTS.FFI.CppFunctional
        MCTS.FFI.CppImperative
        MCTS.FFI.CppLegacy
        MCTS.FFI.Rust
        MCTS.Notation
        MCTS.Plan
        MCTS.Prerequisite
        MCTS.ReportCard
        MCTS.Rng.Mix
        MCTS.Search.Arena
        MCTS.Search.UCT
        MCTS.Subprocess
        MCTS.Transcript
        MCTS.Transcript.Action
        MCTS.Transcript.Cache
        MCTS.Transcript.Codec
        MCTS.Transcript.EquitySidecar
        MCTS.Transcript.Hash
        MCTS.Transcript.Lookup
        MCTS.Types
        MCTS.Verify
        MCTS.Verify.Divergence
        MCTS.Verify.Envelope
    build-depends:
        array,
        base >=4.20 && <5,
        bytestring,
        containers,
        directory,
        filepath,
        mtl,
        process,
        text,
        time,
        transformers,
        unix

executable mcts
    import: warnings
    main-is: Main.hs
    hs-source-dirs: app
    -- Phase 8 Sprint 8.1 RTS pin. `-A64m -n4m -qg1 -qb -T` is the
    -- doctrine-named tuning set baked into the binary so users do not
    -- need to remember to pass `+RTS ... -RTS`.
    ghc-options: -threaded "-with-rtsopts=-A64m -n4m -qg1 -qb -T"
    build-depends:
        base >=4.20 && <5,
        mcts

test-suite mcts-unit
    import: warnings
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test/unit
    build-depends:
        array,
        base >=4.20 && <5,
        bytestring,
        directory,
        filepath,
        mcts,
        mtl,
        transformers

test-suite mcts-integration
    import: warnings
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test/integration
    build-depends:
        base >=4.20 && <5,
        directory,
        mcts

test-suite mcts-cross-backend
    import: warnings
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test/cross-backend
    build-depends:
        base >=4.20 && <5,
        mcts

test-suite mcts-legacy-parity
    import: warnings
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test/legacy-parity
    build-depends:
        base >=4.20 && <5,
        mcts

test-suite mcts-haskell-style
    import: warnings
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test/haskell-style
    build-depends:
        base >=4.20 && <5,
        directory,
        filepath
