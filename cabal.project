packages: .

with-compiler: ghc-9.14.1

-- Sprint 7.4: relax the upper bounds on `config-ini`'s `containers`
-- and `base` so `brick` 2.12 + `vty` 6.5 can resolve under
-- GHC 9.14.1 (which ships `containers 0.8` / `base 4.22`).
-- Documented in `DEVELOPMENT_PLAN/phase-7-cross-backend-verify-and-report-card.md`
-- and `DEVELOPMENT_PLAN/legacy-tracking-for-deletion.md`.
allow-newer: config-ini:containers, config-ini:base

-- Cabal 3.16.1.0 is the pinned project tool.
-- Report-card knobs:
-- G_R=1000
-- G_S=4
-- G_V=4
-- G_LP=2
-- S_BENCH=500
-- S_VERIFY=500
-- S_LP_SIMS=10000
-- S_LP=42
-- PGO_TRAINING_SEEDS=42,424242
-- PGO_TRAINING_MAX_PLIES=1
-- PGO_TRAINING_ROLLOUT_GAMES_ST=2
-- PGO_TRAINING_ROLLOUT_GAMES_MT8=2
-- PGO_TRAINING_SELFPLAY_GAMES_ST=1
-- PGO_TRAINING_SELFPLAY_GAMES_MT8=1
-- PGO_TRAINING_ROLLOUT_SIMS=1
-- PGO_TRAINING_SELFPLAY_SIMS=500
-- BOLT_TRAINING_SEEDS=42,424242
-- BOLT_TRAINING_MAX_PLIES=1
-- BOLT_TRAINING_ROLLOUT_GAMES_ST=1
-- BOLT_TRAINING_ROLLOUT_GAMES_MT8=1
-- BOLT_TRAINING_SELFPLAY_GAMES_ST=1
-- BOLT_TRAINING_SELFPLAY_GAMES_MT8=1
-- BOLT_TRAINING_ROLLOUT_SIMS=1
-- BOLT_TRAINING_SELFPLAY_SIMS=100
-- MOVE_DELTA_NATIVE_MAX=0.005
-- VISIT_DELTA_NATIVE_MAX=0.05
-- MOVE_DELTA_CROSS_BUILD_MAX=0.001
-- VISIT_DELTA_CROSS_BUILD_MAX=0.01
